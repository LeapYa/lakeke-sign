# 复制为 lakeke.env 后按需修改。⚠️ 内含凭证，已被 .gitignore 忽略，别提交。
# 说明：日常签到只需要「身份组 + token」，两者都由 cdp_lakeke_ident.js / auth_refresh_node.js 自动写入。

# ── 身份组（脚本自动填，一般不用手改）──────────────────────────
# LAKEKE_MPID=          gh_ 开头的公众号 id（辣可可租户）
# LAKEKE_OPENID=        该账号在辣可可下的 openId（应等于 token 的 sub）
# LAKEKE_UNIONID=
# LAKEKE_GCID=           分片键（可选）
# LAKEKE_GAMEID=         签到活动 id（长活动常量）
# LAKEKE_MEMBERID=       会员三件套，缺失时 lakeke_run.py 会自动查 /api/member/single 补
# LAKEKE_CARDID=
# LAKEKE_CARDNO=
# LAKEKE_THIRDSHOPID=    门店 id（可选）
# LAKEKE_TOKEN=          短效 JWT（1~2 小时），脚本自动刷新

# ── 首次注册会员（账号还不是会员时才需要）──────────────────────
# auto：有手机号走 API，没有走 UI 弹窗；也可强制 api / ui
LAKEKE_REGISTER_MODE=auto
# 手机号（11 位）。走 API 注册 /api/member/register 直接用它，零 UI
# LAKEKE_REGISTER_PHONE=13800000000
# 走 UI 弹窗兜底时：选第几个手机号（从 1 开始）。只有 1 个号码时不用设；
# 多个号码又不设 → 脚本报错退出并留截图，不会瞎猜
# LAKEKE_REGISTER_PHONE_INDEX=1

# ── 容器 / 运行环境 ────────────────────────────────────────────
WOC_INSTANCE=woc-wx-2ada0225ca
WOC_HOOK=woc-hook
# Linux 上改成 /usr/bin/python3；Windows 填绝对路径
LAKEKE_PYTHON=C:/Users/tingjian/.workbuddy/binaries/python/envs/default/Scripts/python.exe

# ── 通知渠道（配了哪个发哪个，全部走 notify.py）──────────────────
# 成功也发一条（推荐 1，否则你无法确认它还在跑）
LAKEKE_NOTIFY_ALWAYS=0
# 企业微信机器人（markdown 上限 4096B，机器人限 20 条/分钟）
# WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxx
# PushPlus（成功码 200；会员 10 万字 / 实名 2 万字，脚本会自动降级重试）
# PUSHPLUS_TOKEN=
# WXPusher（成功码 1000）
# WXPUSHER_APP_TOKEN=
# WXPUSHER_UIDS=
# WXPUSHER_TOPIC_IDS=
# 钉钉机器人（errcode=0；开了加签必须填 secret，否则报 310000）
# DINGTALK_ACCESS_TOKEN=
# DINGTALK_SECRET=
# 邮件（465 走 SSL，其它端口自动试 STARTTLS）
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# SMTP_TO=
# 通用 webhook（POST JSON {title,text,msgtype}）
# LAKEKE_NOTIFY_URL=
